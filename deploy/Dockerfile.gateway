FROM python:3.12.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .
RUN useradd -u 10001 -m gateway && mkdir /app/runtime && chown gateway:gateway /app/runtime
USER gateway
EXPOSE 8080
CMD ["uvicorn", "speech_gateway.server:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--ws-max-size", "32768", "--ws-max-queue", "4", "--limit-concurrency", "100"]
