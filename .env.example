# Generate independent >=32-character random secrets. Never commit .env.
GATEWAY_TOKEN=
GENESYS_TOKEN=
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_SESSIONS=20
MAX_MODEL_JOBS=4
# Private deployment: OpenAI-compatible local ASR/TTS endpoints, not OpenRouter.
ASR_BASE_URL=http://asr:8000/v1
TTS_BASE_URL=http://tts:8000/v1
MODEL_API_KEY=
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
TTS_MODEL=openbmb/VoxCPM2
# voice belongs to the configured provider. Verify licensed Arabic voice locally.
TTS_VOICE=default
# External business agent contract described in docs/integration.md.
BUSINESS_URL=
BUSINESS_TOKEN=
DEMO_BUSINESS=true
